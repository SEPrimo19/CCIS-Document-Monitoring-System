# Copy to .env and adjust for your machine. Defaults below match a stock XAMPP install.
#
# APP_ENV=development is for LOCAL DEV ONLY: it shows raw exception text, and it
# is what scripts/migrate.php requires before it will drop and recreate every
# table. It ships COMMENTED OUT deliberately — the documented first step of a
# deployment is `copy .env.example .env`, so an example that sets it would hand
# every deployment the debug posture by default. Unset (or any unrecognized
# value) resolves to hardened production, which is the right default for a copy
# whose destination this file cannot know.
#
# Local development: uncomment the next line. If you forget, step 5 of SETUP.md
# tells you so in as many words rather than failing quietly.
#APP_ENV=development
APP_NAME="CCIS Document Monitoring System"

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ccis_dms
DB_USER=root
DB_PASS=

# One timezone drives both PHP and the MySQL session, so date/time comparisons
# never straddle a clock skew between the app server and the DB server.
# Defaults to Asia/Manila (the institution's zone) when unset.
#APP_TIMEZONE=Asia/Manila

# Uncomment to force production-mode hardening (no error detail) even with
# APP_ENV=development. The session cookie's Secure flag is independent of this
# — it always follows the actual transport (HTTPS), never env/debug.
#APP_DEBUG=false

# Read by scripts/migrate.php when seeding the default Secretary account.
# Defaults to Secretary@123 for local dev when unset.
#SECRETARY_PASSWORD=Secretary@123

# Read by scripts/migrate.php when seeding the dev Faculty accounts. Defaults
# to Faculty@123 for local dev when unset.
#FACULTY_PASSWORD=Faculty@123
