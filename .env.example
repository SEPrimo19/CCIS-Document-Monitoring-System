# Copy to .env and adjust for your machine. Defaults below match a stock XAMPP install.
APP_ENV=development
APP_NAME="CCIS Document Monitoring System"

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ccis_dms
DB_USER=root
DB_PASS=

# Uncomment to force production-mode hardening (secure cookies, no error detail).
#APP_DEBUG=false

# Read by scripts/migrate.php when seeding the default admin. Defaults to
# Admin@123 for local dev when unset.
#ADMIN_PASSWORD=Admin@123

# Read by scripts/migrate.php when seeding the dev Reviewer/Approver and
# Faculty accounts. Default to Reviewer@123 / Faculty@123 for local dev
# when unset.
#REVIEWER_PASSWORD=Reviewer@123
#FACULTY_PASSWORD=Faculty@123
